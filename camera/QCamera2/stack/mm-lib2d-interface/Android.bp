
cc_library_shared {
    name: "libmmlib2d_interface",

    cflags: [
        "-D_ANDROID_",
        "-DQCAMERA_REDEFINE_LOG",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
        "-DUSE_ION",
    ],
    include_dirs: [
        "system/memory/libion/include",
        "system/memory/libion/kernel-headers",
    ],
    local_include_dirs: [
        "inc",
        "inc1",
    ],

    header_libs: ["libutils_headers",],

    

    srcs: ["src/mm_lib2d.c",],

    

    shared_libs: [
        "libdl",
        "libcutils",
        "liblog",
        "libmmcamera_interface",
        "libion",
    ],

    vendor: true,

    compile_multilib: "32",

}
