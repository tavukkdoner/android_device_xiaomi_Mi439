
cc_library_shared {
    name: "libmmlib2d_interface",

    header_libs: [
        "libutils_headers",
        "generated_kernel_headers",
    ],
	
    cflags: [
        "-D_ANDROID_",
        "-DQCAMERA_REDEFINE_LOG",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
        "-DUSE_ION",
    ],
    include_dirs: [
        "system/memory/libion/include",
        "system/memory/libion/kernel-headers",
        "device/xiaomi/Mi439/camera/QCamera2/stack/common",
        "device/xiaomi/Mi439/camera/QCamera2/stack/mm-camera-interface/inc",
    ],
    local_include_dirs: [
        "inc",
    ],

    

    srcs: ["src/mm_lib2d.c",],

    

    shared_libs: [
        "libdl",
        "libcutils",
        "liblog",
        "libmmcamera_interface",
        "libion",
    ],

    vendor: true,

    compile_multilib: "32",

}
