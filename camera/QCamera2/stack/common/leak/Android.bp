cc_library_shared {
    name: "libhal_dbg",
    cflags: [
        "-D_ANDROID_",
        "-Werror",
        "-Wunused-parameter",
        "-D__BIONIC_FORTIFY",
    ],
    local_include_dirs: [
        "../", 
        ".",
        "../../mm-camera-interface/inc",
    ],

    header_libs: ["libutils_headers"],

    srcs: [
        "fdleak.cpp",
        "memleak.cpp",
    ],
    shared_libs: [
        "libdl",
        "libcutils",
        "liblog",
    ],

    vendor: true,
}
