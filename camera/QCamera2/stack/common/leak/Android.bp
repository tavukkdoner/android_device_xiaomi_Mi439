cc_library_shared {
    name: "libhal_dbg",
    cflags: [
        "-D_ANDROID_",
        "-Werror",
        "-Wunused-parameter",
        "-D__BIONIC_FORTIFY",
    ],
    include_dirs: [
        "device/xiaomi/Mi439/camera/QCamera2/stack/common",
        "device/xiaomi/Mi439/camera/QCamera2/stack/mm-camera-interface/inc",
    ],
    local_include_dirs: [
        ".",
    ],

    header_libs: [
        "libutils_headers",
        "generated_kernel_headers",
    ],

    srcs: [
        "fdleak.cpp",
        "memleak.cpp",
    ],
    shared_libs: [
        "libdl",
        "libcutils",
        "liblog",
    ],

    vendor: true,
}
