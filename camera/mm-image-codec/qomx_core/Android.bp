cc_library_shared {
    name: "libqomx_core",

    cflags: [
        "-Werror",
        "-g",
        "-O0",
    ],

    include_dirs: ["device/xiaomi/Mi439/camera/mm-image-codec/qexif",],
    local_include_dirs: [".",],

    header_libs: [
        "libutils_headers",
        "media_plugin_headers",
    ],

    srcs: ["qomx_core.c",],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
    ],
    vendor: true,

    compile_multilib: "32",
}
