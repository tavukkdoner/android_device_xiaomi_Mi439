<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Whether a software navigation bar should be shown. NOTE: in the future this may be
         autodetected from the Configuration. -->
     <bool name="config_showNavigationBar">true</bool>

    <!-- Whether device supports double tap to wake -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- Enables or disables haptic effect when the text insertion/selection handle is moved
         manually by the user. Off by default, since the expected haptic feedback may not be
         available on some devices. -->
    <bool name="config_enableHapticTextHandle">true</bool>
	
    <!-- True if the device supports Sustained Performance Mode -->
    <bool name="config_sustainedPerformanceModeSupported">true</bool>
	
    <!-- Whether or not the monitoring on the apps' background battery drain is enabled -->
    <bool name="config_bg_current_drain_monitor_enabled">true</bool>
	
    <!-- Flag indicating whether we should enable the adaptive sleep.-->
    <bool name="config_adaptive_sleep_available">true</bool>
	
    <!-- Shutdown if the battery temperature exceeds (this value * 0.1) Celsius. -->
    <integer name="config_shutdownBatteryTemperature">600</integer>

    <!-- Enable Zram writeback feature to allow unused pages in zram be written to flash. -->
    <bool name="config_zramWriteback">true</bool>

    <!-- Default for BatterySaverPolicy.DEFAULT_FULL_POLICY.disableAnimation -->
    <bool name="config_batterySaver_full_disableAnimation">true</bool>
	
    <!-- Minimum screen brightness setting allowed by power manager.
         -2 is invalid so setting will resort to int value specified above.
         Set this to 0.0 to allow screen to go to minimal brightness.
         The user is forbidden from setting the brightness below this level. -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.0</item>

    <!-- Maximum screen brightness allowed by the power manager.
         -2 is invalid so setting will resort to int value specified above.
         Set this to 1.0 for maximum brightness range.
         The user is forbidden from setting the brightness above this level. -->
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>

    <!-- Default screen brightness setting set.
         -2 is invalid so setting will resort to int value specified above.
         Must be in the range specified by minimum and maximum. -->
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.25</item>

	
    <!-- Define device configs on boot -->
    <string-array name="device_configs_override" translatable="false">
        <!-- Cache apps freezer -->
        <item>activity_manager_native_boot/use_freezer=true</item>	
		
        <!-- Enable the new oom adjuster implementation -->
        <item>activity_manager_native_boot/enable_new_oom_adj=true</item>
		
        <!-- Enable the batching of OOM adjuster calls to LMKD -->
        <item>activity_manager_native_boot/enable_batching_oom_adj=true</item>
		
        <!-- Move app to restricted standby level automatically when system detects it's abusive. -->
        <item>activity_manager/bg_auto_restrict_abusive_apps=true</item>
        <item>activity_manager/bg_current_drain_auto_restrict_abusive_apps_enabled=true</item>
		
		
        <!-- Enable Re-rank oom adjust scores -->
        <item>activity_manager/use_oom_re_ranking=true</item>
		
        <!-- Enable proactive killing cached apps -->
        <item>activity_manager/proactive_kills_enabled=true</item>
		
        <!-- Enable use modern trim -->
        <item>activity_manager/use_modern_trim=true</item>
		
        <!-- Enable oom_adj_score tiers for cached apps -->
        <item>activity_manager/use_tiered_cached_adj=true</item>
        <item>activity_manager/tiered_cached_adj_decay_time=60000</item>
		
        <!-- LMKD Thrashing Limit Critical -->
        <item>lmkd_native/thrashing_limit_critical=300</item>

        <!-- The maximum number of jobs we'll attempt to have running at one time. -->
        <item>jobscheduler/concurrency_limit=8</item>

        <!-- Minimum # of jobs that have to be ready for JS to be happy running work -->
        <item>jobscheduler/min_ready_cpu_only_jobs_count=2</item>

        <!-- Minimum # of non-ACTIVE jobs that have to be ready for JS to be happy running work. -->
        <item>jobscheduler/min_ready_non_active_jobs_count=3</item>
    </string-array>
</resources>
