# LMKD

ro.lmk.low=1001
ro.lmk.medium=800
ro.lmk.critical=300
ro.lmk.critical_upgrade=true
ro.lmk.upgrade_pressure=40
ro.lmk.downgrade_pressure=60
ro.lmk.kill_heaviest_task=false
ro.lmk.kill_timeout_ms=0
ro.lmk.use_minfree_levels=false
ro.lmk.swap_free_low_percentage=5
ro.lmk.thrashing_limit=50
ro.lmk.thrashing_limit_decay=30
ro.lmk.lowmem_min_oom_score=701
ro.lmk.use_psi=false
ro.lmk.psi_partial_stall_ms=200
ro.lmk.psi_complete_stall_ms=700
ro.lmk.swap_util_max=100
ro.lmk.log_stats=true

# Broadcast Parameters used isLowRamDeviceStatic values
persist.device_config.activity_manager_native_boot.bcast_max_running_active_broadcasts=8
persist.device_config.activity_manager_native_boot.bcast_max_core_running_blocking_broadcasts=8
persist.device_config.activity_manager_native_boot.bcast_max_core_running_non_blocking_broadcasts=32
persist.device_config.activity_manager_native_boot.bcast_max_pending_broadcasts=128
persist.device_config.activity_manager_native_boot.bcast_max_history_complete_size=64
persist.device_config.activity_manager_native_boot.bcast_max_history_summary_size=256
persist.device_config.activity_manager_native_boot.bcast_max_running_process_queues=2

# ZRAM Toggling Support
persist.sys.zram_enabled=1

# ZRAM Force Writeback while using device
zram.force_writeback=false
ro.zram.mark_idle_delay_mins=20
ro.zram.first_wb_delay_mins=60
ro.zram.periodic_wb_delay_hours=2

# Set Max Background Services
ro.config.max_starting_bg=3

# Allow Avoiding GFX Acceleration
ro.config.avoid_gfx_accel=true
